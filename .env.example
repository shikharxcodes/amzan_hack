# Optional conversational answers. Core task management and study planning work without Gemini.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Dates default to India Standard Time; override with an IANA timezone if needed.
STUDYMATE_TIMEZONE=Asia/Kolkata

# Optional: path to the local JSON data file. Defaults to ./data.json.
# STUDYMATE_DATA_FILE=./data.json

# Optional: HTTP port. Defaults to 3000.
# PORT=3000
